# Copy to .env and replace in non-demo environments
APP_ENV=development
JWT_SECRET=change-this-development-secret
JWT_EXPIRE_MINUTES=30
DATABASE_PATH=./data/venue_backend.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true = commands use the simulator; false = real drivers must be registered
MOCK_MODE=true
