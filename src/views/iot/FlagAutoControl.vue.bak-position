    voltage: '381V / 50Hz',
    currentA: 2.2,
    lastCmd: '待机就绪',
    updated: '--:--:--',
    loading: false
  }
])

const checkedIds = ref(devices.value.filter(d => d.status !== 'OFFLINE').map(d => d.id))

const selectedDevices = computed(() =>
  devices.value.filter(d => checkedIds.value.includes(d.id))
)

function removeControlledDevice(id) {
  const i = checkedIds.value.indexOf(id)
  if (i > -1) {
    checkedIds.value.splice(i, 1)
    ElMessage.info(`已将设备 ${id} 移出受控列表`)
    logLine(`受控机组变更：移除设备 ${id}`)
  }
}

const allChecked = computed({
  get: () => devices.value.length > 0 && checkedIds.value.length === devices.value.filter(d => d.status !== 'OFFLINE').length,
  set: v => {
    checkedIds.value = v ? devices.value.filter(d => d.status !== 'OFFLINE').map(d => d.id) : []
  }
})

const isIndeterminate = computed(() => {
  const selectable = devices.value.filter(d => d.status !== 'OFFLINE').length
  return checkedIds.value.length > 0 && checkedIds.value.length < selectable
})

function toggleDevice(id) {
  const i = checkedIds.value.indexOf(id)
  if (i > -1) checkedIds.value.splice(i, 1)
  else checkedIds.value.push(id)
}

function devStatusClass(dev) {
  if (dev.status === 'OFFLINE') return 'offline'
  if (dev.status === 'ESTOP') return 'danger'
  if (dev.status === 'BUSY') return 'warning'
  return 'online'
}

// 仪式运行时: 对应旗杆的高度实时回读
function syncDevicesLive() {
  const t = nowStr()
  devices.value.forEach((d, idx) => {
    if (d.status === 'OFFLINE') return
    if (idx === 0) {
      d.heightM = +championH.value.toFixed(2)
    } else if (idx === 1) {
      d.heightM = +runnerUpH.value.toFixed(2)
    } else if (idx === 2) {
      d.heightM = +thirdH.value.toFixed(2)
    }
    d.rpm = motorRpm.value
    d.updated = t
  })
}

async function readDevice(dev) {
  dev.loading = true
  const hw = await syncFlagHardwareStatus(false)
  dev.loading = false
  if (hw) {
    ElMessage.success(`${dev.id} 真实回读: ${hw.run_status_text} · 脉冲 ${hw.total_pulses} · 国歌 ${hw.anthem_duration_sec}s · ${hw.limit_top_text}`)
  }
}

function tweenDevice(dev, toM, label) {
  const from = dev.heightM
  const start = performance.now()
  if (dev._t) clearInterval(dev._t)
  dev._t = setInterval(() => {
    const k = Math.min(1, (performance.now() - start) / 900)
    dev.heightM = +(from + (toM - from) * (1 - Math.pow(1 - k, 3))).toFixed(2)
    dev.rpm = 1200
    dev.updated = nowStr()
    if (k >= 1) {
      clearInterval(dev._t)
      dev._t = null
      dev.rpm = 0
      dev.status = 'ONLINE'
      dev.lastCmd = label + '完成'
      dev.updated = nowStr()
      ElMessage.success(`${dev.id} ${label}完成`)
      logLine(`${dev.id} ${label}完成 (${dev.heightM.toFixed(2)}m)`)
    }
  }, 50)
}

const CMD_LABELS = {
  estop: '紧急停止',
  simulate: '模拟颁奖',
  official: '正式颁奖',
  zero: '校准归零',
  top: '强制升顶'
}

function devCommand(dev, cmd) {
  if (dev.status === 'OFFLINE') {
    ElMessage.warning(`${dev.id} 离线，指令无法下发`)
    return
  }
  if (cmd === 'read') {
    readDevice(dev)
    return
  }
  dev.lastCmd = CMD_LABELS[cmd] + ' → 已下发'
  dev.updated = nowStr()
  logLine(`${dev.id} ← ${CMD_LABELS[cmd]}`)
  switch (cmd) {
    case 'estop':
      handleEmergencyStop()
      dev.status = 'ESTOP'
      break
    case 'simulate':
    case 'official':
      if (!isRunning.value) {
        activeDeviceId = dev.id
        if (cmd === 'official') {
          const c = champion.value
          ElMessageBox.confirm(
            `将向 ${dev.id} 正式下发「正式颁奖」指令${c ? `（冠军 ${c.nameCn}，奏《${c.anthemName}》)` : ''}。是否继续？`,
            '正式颁奖确认',
            { type: 'warning', confirmButtonText: '正式下发', cancelButtonText: '取消' }
          ).then(() => {
            runCeremony('official')
            syncDevicesLive()
          }).catch(() => {
            dev.lastCmd = '正式颁奖 → 已取消'
          })
        } else {
          runCeremony('simulate')
        }
      } else {
        dev.lastCmd = CMD_LABELS[cmd] + ' → 跟随主仪式'
      }
      break
    case 'zero':
      tweenDevice(dev, 0, '校准归零')
      break
    case 'top':
      tweenDevice(dev, totalHeightM, '强制升顶')
      break
  }
}

function batchCommand(cmd) {
  const targets = devices.value.filter(d => checkedIds.value.includes(d.id) && d.status !== 'OFFLINE')
  if (!targets.length) {
    ElMessage.warning('请先勾选至少一台在线设备')
    return
  }
  if (cmd === 'official') {
    const c = champion.value
    ElMessageBox.confirm(
      `将向 ${targets.length} 台在线设备正式下发「正式颁奖」指令${c ? `（冠军 ${c.nameCn}，奏《${c.anthemName}》并同步升旗）` : ''}。是否继续？`,
      '正式颁奖批量下发',
      { type: 'warning', confirmButtonText: '正式下发', cancelButtonText: '取消' }
    ).then(() => {
      targets.forEach(d => devCommand(d, 'official'))
    }).catch(() => { })
    return
  }
  targets.forEach(d => devCommand(d, cmd))
}

/* ============================================================
 * 七、生命周期
 * ============================================================ */
onMounted(() => {
  window.addEventListener('keydown', handleEscKey)
  startWaveLoop()
  syncFlagHardwareStatus(true)
  if (route.query.select) {
    openCountrySelectModal(route.query.select)
  }
})

onUnmounted(() => {
  stopWaveLoop()
  stopReadSyncPolling()
  stopMotionPolling()
  if (animTimer) clearInterval(animTimer)
  stopAnthem()
  if (modalAudioPlayer) {
    modalAudioPlayer.pause()
    modalAudioPlayer = null
  }
  devices.value.forEach(d => { if (d._t) clearInterval(d._t) })
})
</script>

